{
  "expo": {
    "name": "Aurashape — Food Tracker, Fasting & Workout Log",
    "slug": "aurashape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aurashape",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.aurashape",
      "infoPlist": {
        "NSCameraUsageDescription": "Aurashape uses your camera to scan food barcodes and take progress photos. Photos are stored privately and only you can see them.",
        "NSPhotoLibraryUsageDescription": "Aurashape accesses your photo library to save and view progress photos.",
        "NSUserTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you. (We don't actually serve ads — this is required by Apple for analytics opt-in.)",
        "CFBundleDisplayName": "Aurashape",
        "CFBundleName": "Aurashape",
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "1",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4ADE80",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.aurashape",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aurashape to access your camera to scan food barcodes and take progress photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-foreground.png",
          "color": "#4ADE80"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aurashape to access your photos for progress tracking."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      [
        "@sentry/react-native",
        {
          "project": "aurashape",
          "organization": "hamzaelbouhali"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aurashape"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
