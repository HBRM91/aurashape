{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer YOUR_GITHUB_PAT"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "gemini": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "github:aliargun/mcp-server-gemini"],
      "env": {
        "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY"
      },
      "enabled": false
    },
    "deepseek": {
      "type": "local",
      "command": "uvx",
      "args": ["deepseek-mcp-server"],
      "env": {
        "DEEPSEEK_API_KEY": "YOUR_DEEPSEEK_API_KEY"
      },
      "enabled": false
    },
    "unsplash": {
      "type": "local",
      "command": "uvx",
      "args": ["unsplash-mcp-server"],
      "env": {
        "UNSPLASH_ACCESS_KEY": "YOUR_UNSPLASH_ACCESS_KEY"
      },
      "enabled": false
    },
    "pexels": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "pexels-image-search-mcp@latest"],
      "env": {
        "PEXELS_API_KEY": "YOUR_PEXELS_API_KEY"
      },
      "enabled": false
    },
    "supabase": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@supabase/mcp-server"],
      "env": {
        "SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR_SUPABASE_SERVICE_ROLE_KEY"
      },
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "./"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://user:password@localhost:5432/dbname"],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-server-sqlite", "--db-path", "./db.sqlite"],
      "enabled": false
    },
    "redis": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"],
      "enabled": false
    },
    "mongodb": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-mongodb", "mongodb://localhost:27017/dbname"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "enabled": true
    },
    "brave-search": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY"
      },
      "enabled": false
    },
    "docker": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-docker"],
      "enabled": false
    },
    "aws-kb-retrieval": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-server-aws-kb-retrieval"],
      "env": {
        "AWS_ACCESS_KEY_ID": "YOUR_AWS_ACCESS_KEY",
        "AWS_SECRET_ACCESS_KEY": "YOUR_AWS_SECRET_KEY",
        "AWS_REGION": "us-east-1"
      },
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.io/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer YOUR_SENTRY_AUTH_TOKEN"
      }
    },
    "vercel": {
      "type": "remote",
      "url": "https://mcp.vercel.com/mcp",
      "enabled": false,
      "headers": {
        "Authorization": "Bearer YOUR_VERCEL_TOKEN"
      }
    }
  }
}